#!/bin/bash

i3status | while read -r line; do
    media=""

    for player in $(playerctl -l 2>/dev/null); do
        status=$(playerctl -p "$player" status 2>/dev/null)

        if [[ "$status" == "Playing" ]]; then
            media=$(playerctl -p "$player" metadata \
                --format '{{artist}} - {{title}}' 2>/dev/null)
            break
        fi
    done

    if [[ -n "$media" ]]; then
        echo "$media | $line "
    else
        echo "$line "
    fi
done
